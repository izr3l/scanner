{
  "name": "vaultscan",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && next dev --webpack",
    "build": "node scripts/prepare-assets.mjs && next build --webpack && node scripts/postbuild.mjs",
    "start": "npm run preview",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.sw.json",
    "lint": "eslint app components lib stores tests --ignore-pattern lib/asset-integrity.ts",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepare": "node scripts/prepare-assets.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/syne": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@radix-ui/react-slot": "1.5.0",
    "@techstark/opencv-js": "5.0.0-release.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "motion": "14.2.0",
    "next": "16.4.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serwist": "9.5.13",
    "sonner": "2.0.8",
    "tesseract.js": "7.0.0",
    "vaul": "1.1.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@serwist/build": "9.5.13",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
